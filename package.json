{
  "name": "thatwastheyear",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run scripts/build",
    "serve": "bun run --watch scripts/server",
    "validate-songs": "bun run scripts/validate-songs",
    "check-songs": "bun run scripts/check-songs",
    "add-song": "bun run scripts/add-song",
    "add-song-web": "bun run scripts/add-song-server",
    "songs-per-year": "bun run scripts/songs-per-year",
    "tc": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "slint": "stylelint assets/*.css",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test src/",
    "checks": "bun run tc && bun run lint && bun run fmt:check && bun run test && bun run slint"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
